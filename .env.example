# Modèle de configuration locale. Copier ce fichier en .env puis remplacer les valeurs.
#   cp .env.example .env
# Le fichier .env n'est jamais versionné. Aucune valeur ci-dessous n'est réelle.

# --- PostgreSQL local ---
POSTGRES_USER=quiz_user
# Mot de passe alphanumérique : les caractères @ : / # casseraient l'URL de connexion.
# Générer avec : openssl rand -hex 16
POSTGRES_PASSWORD=changeme
POSTGRES_DB=quiz_db

# --- Envoi d'emails (Resend) ---
# Le backend ne démarre pas sans cette variable.
# Sans accès Resend, laisser la valeur factice : les emails ne partiront pas,
# le reste de l'application fonctionne.
RESEND_API_KEY=re_placeholder
FROM_EMAIL=Quiz App <noreply@votredomaine.com>

# --- Administration ---
ADMIN_USERNAME=admin
# Générer avec : openssl rand -hex 16
ADMIN_PASSWORD=changeme
# Générer avec : openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string

# --- Port du frontend sur le poste (facultatif, 8087 par défaut) ---
FRONTEND_PORT=8087
