# Modèle des secrets pour le déploiement Azure. Copier en .env.azure puis remplacer les valeurs.
#   cp .env.azure.example .env.azure
# Le fichier .env.azure n'est jamais versionné. Aucune valeur ci-dessous n'est réelle.
# Utiliser des valeurs différentes de celles du .env local.
# Format : une variable par ligne, NOM=valeur, sans guillemets ni espaces autour du signe égal.

# --- Administration ---
ADMIN_USERNAME=admin
# Générer avec : openssl rand -hex 16
ADMIN_PASSWORD=changeme
# Générer avec : openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string

# --- Envoi d'emails (Resend) ---
# Le backend ne démarre pas sans cette variable. Valeur factice acceptée.
RESEND_API_KEY=re_placeholder

# --- PostgreSQL externe (jalon 5) ---
# Laisser vide tant que la base cloud n'existe pas : le backend démarre quand même.
# Forme attendue : postgres://utilisateur:motdepasse@hote/base?sslmode=require
DATABASE_URL=
